# ==============================================================================
# PayPilot AI - Root Environment Template
# ==============================================================================
# Copy this file to .env in local environments.
# NEVER commit real credentials, API tokens, or secrets to version control.
# ==============================================================================

# --- Node Environment ---
NODE_ENV=development

# --- Backend Configuration ---
PORT=5000
BACKEND_URL=http://localhost:5000
CORS_ORIGIN=http://localhost:3000

# --- Frontend Configuration ---
PORT_FRONTEND=3000
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_APP_NAME=PayPilot AI
NEXT_PUBLIC_ENABLE_MOCK_API=true

# --- Database (PostgreSQL) ---
# Default local PostgreSQL connection details
DB_HOST=localhost
DB_PORT=5432
DB_NAME=paypilot_db
DB_USER=paypilot_user
DB_PASSWORD=your_secure_db_password_here
DATABASE_URL=postgresql://paypilot_user:your_secure_db_password_here@localhost:5432/paypilot_db
# Set to 'true' in development to run backend with in-memory stubs if PostgreSQL is not installed
ALLOW_OFFLINE_DB=true

# --- Authentication ---
JWT_SECRET=your_jwt_secret_change_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# --- PayPal Sandbox Configuration ---
# Obtain from https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_sandbox_client_secret_here
PAYPAL_WEBHOOK_ID=your_paypal_sandbox_webhook_id_here

# --- AI Provider Configuration ---
# Choose one provider: 'gemini' or 'openai' or 'mock'
AI_PROVIDER=mock
AI_API_KEY=your_ai_api_key_here
AI_MODEL_NAME=gemini-1.5-flash
